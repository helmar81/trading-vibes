---
import PivotPointCalculator from '../components/PivotPointCalculatorImpl.jsx';
import Layout from '../layouts/BlogPost.astro';
---

<Layout
  title="Trigger"
  description="Calculate Long and Short Trigger"
  pubDate={new Date()}
>
  <main class="py-12 lg:py-20 px-4">
    <section class="max-w-4xl mx-auto text-center mb-12">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-gray-800">
        Daily Pivot Point Calculator
      </h1>
      <p class="mt-4 text-base sm:text-lg text-gray-600">
        Calculate your long and short trigger levels with precision.
      </p>
    </section>

    <section class="max-w-2xl mx-auto">
      <div class="bg-white p-6 sm:p-8 rounded-xl shadow-lg">
        <PivotPointCalculator client:load />
      </div>
    </section>
  </main>
</Layout>
